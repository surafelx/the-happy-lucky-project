# --- Google Sheet (recommended on Vercel) ---------------------------------
# The join form appends a row [timestamp, email, source] to this sheet.
# 1. Google Cloud console: create a project, enable the "Google Sheets API",
#    create a Service Account and download its JSON key.
# 2. Share the spreadsheet with the service account's email as an Editor.
# 3. Paste the values below (on Vercel: Project > Settings > Environment Variables).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" from the JSON key. Vercel accepts the multi-line value as-is;
# in a .env file keep it on one line with \n between lines.
GOOGLE_PRIVATE_KEY=
# Optional. Tab name inside the spreadsheet (default: Sheet1).
GOOGLE_SHEETS_TAB=

# --- Or a webhook ----------------------------------------------------------
# Used only when the Google Sheet variables are not set. Each join is POSTed
# here as JSON {email, at, source} (Zapier, Make, Apps Script, Formspree, ...).
JOIN_WEBHOOK_URL=

# --- Database (see BACKEND.md) ---------------------------------------------
# Postgres connection string. On Vercel: Storage > Create Database > Neon, which
# sets this for you. Leave it empty locally and an embedded Postgres is created
# in data/pgdata on the first request.
DATABASE_URL=

# --- Mentor track, campaigns & the office ----------------------------------
# NEXT_PUBLIC_MENTOR_FORM=1 turns on /mentor, /partners, /work, /campaigns and
# /office (see .env.development). /me stays local-only for now.
# Passcode for /office. Required on Vercel, together with DATABASE_URL.
# With none set the office is open, which is allowed in development only.
OFFICE_PASSCODE=
